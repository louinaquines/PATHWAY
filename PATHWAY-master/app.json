{
  "expo": {
    "name": "PATHWAY",
    "slug": "pathway-app3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pathway-app-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PATHWAY checks your location only when you punch attendance at a company with geofencing enabled."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/pathway-logo-2026-cutout.png",
      "imageWidth": 236,
      "resizeMode": "contain",
      "backgroundColor": "#F6F8FB"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.louijay.pathway",
      "adaptiveIcon": {
        "foregroundImage": "./assets/pathway-adaptive-foreground.png",
        "backgroundColor": "#F5F8FF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/pathway-favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1826dd53-e8bb-4dd2-82a5-80c5d8870e53"
      }
    },
    "owner": "louijay"
  }
}
